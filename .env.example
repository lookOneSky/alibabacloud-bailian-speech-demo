# Fill in a Beijing-region Bailian API key, or enter it on the local page.
DASHSCOPE_API_KEY=
TTS_MODEL=qwen-audio-3.1-tts-flash
TTS_VOICE=longanfengyue_v3.1
DASHSCOPE_WEBSOCKET_URL=wss://dashscope.aliyuncs.com/api-ws/v1/inference
# For a workspace-specific endpoint, replace the URL above with the one in your console.
# Optional voice creation HTTP base URL; when empty, derived from the WebSocket host.
DASHSCOPE_HTTP_URL=
NETWORK_PROXY=http://127.0.0.1:10808
NO_PROXY=127.0.0.1,localhost,::1
APP_PORT=7860
